# --- Frontend (Vercel) ---
# Dev (Vite proxy handles /api -> Flask, leave empty):
VITE_API_BASE_URL=
# Prod: set in Vercel dashboard to your backend URL:
# VITE_API_BASE_URL=https://findit-api.onrender.com
# Optional: override Vite dev proxy target (default http://127.0.0.1:5000):
# VITE_API_PROXY=http://127.0.0.1:5000

# --- Backend (Render / Railway) ---
# Where the public review links point:
# FINDIT_BASE_URL=https://findit-api.onrender.com
# SQLite file (Render disk mounts at /data):
# FINDIT_DB=/data/findit.db
# Comma-separated browser origins allowed to call /api/*:
# FINDIT_ALLOWED_ORIGINS=https://findit-rosy.vercel.app
# Email (Brevo HTTPS preferred where SMTP ports are blocked):
# MAIL_FROM=findit@localhost
# BREVO_API_KEY=
# Or plain SMTP:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# PORT is provided by the host; Flask defaults to 5000 locally.
